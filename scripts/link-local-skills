#!/usr/bin/env bash
#
# link-local-skills
# Repair repo symlinks in ~/.agents/skills that `skills update -g` (or a fresh
# `skills add`) replaced with directory copies: trash the copy, link the repo
# dir. Only touches installs stamped with our github-repo marker (added by the
# `skills` CLI at install time, not present in the source SKILL.md); foreign
# installs and symlinks are left alone. Displaced copies go through `trash`,
# never `rm`. Silent when everything already points here.
#
# Usage:
#   ./scripts/link-local-skills                 # repair all
#   ./scripts/link-local-skills --skill=<name>  # repair one
#
# Env: REPO_DIR, TARGET_DIR, OUR_REPO (defaults: this repo, ~/.agents/skills,
#      https://github.com/bermudi/skills)

set -u

REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
TARGET_DIR="${TARGET_DIR:-$HOME/.agents/skills}"
OUR_REPO="${OUR_REPO:-https://github.com/bermudi/skills}"

ONLY=""
for arg in "$@"; do
  case "$arg" in
    --skill=*) ONLY="${arg#--skill=}" ;;
    -h|--help) sed -n '2,/^$/p' "$0"; exit 0 ;;
    *) echo "unknown arg: $arg (try --help)" >&2; exit 2 ;;
  esac
done

for repo_skill in "$REPO_DIR"/*/; do
  [[ -f "${repo_skill}SKILL.md" ]] || continue
  name="$(basename "$repo_skill")"
  [[ -n "$ONLY" && "$name" != "$ONLY" ]] && continue
  target="$TARGET_DIR/$name"

  if [[ -L "$target" ]]; then
    [[ "$(readlink "$target")" == "$REPO_DIR/$name" ]] \
      || echo "SKIP    $name (symlink points elsewhere: $(readlink "$target"))"
  elif [[ -d "$target" ]] && grep -qF "github-repo: $OUR_REPO" "$target/SKILL.md" 2>/dev/null; then
    trash "$target" && ln -s "$REPO_DIR/$name" "$target" \
      && echo "LINKED  $name (previous copy trashed)" \
      || echo "FAILED  $name" >&2
  elif [[ -d "$target" ]]; then
    echo "SKIP    $name (installed copy is not from our repo)"
  else
    echo "SKIP    $name (not installed)"
  fi
done
